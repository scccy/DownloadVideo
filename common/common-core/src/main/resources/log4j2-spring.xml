<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="DEBUG" packages="org.apache.logging.log4j.core,com.lmax.disruptor">
    <Properties>
        <Property name="APP_NAME">${spring:spring.application.name}</Property>
        <Property name="LOG_PATH">logs/${APP_NAME}</Property>
        <Property name="PATTERN_FORMAT">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} [%file:%line] - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- 控制台输出，开发调试用 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%highlight{${PATTERN_FORMAT}}{FATAL=red, ERROR=red, WARN=yellow, INFO=blue, DEBUG=green}"/>
        </Console>

        <!-- DEBUG日志 -->
        <RollingFile name="DebugFile"
                    fileName="${LOG_PATH}/debug.log"
                    filePattern="${LOG_PATH}/debug-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN_FORMAT}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
        </RollingFile>

        <!-- ERROR日志 -->
        <RollingFile name="ErrorFile"
                    fileName="${LOG_PATH}/error.log"
                    filePattern="${LOG_PATH}/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN_FORMAT}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
        </RollingFile>

        <!-- 异步 Appenders -->
        <Async name="AsyncDebug" bufferSize="512">
            <AppenderRef ref="DebugFile"/>
        </Async>
        <Async name="AsyncError" bufferSize="512">
            <AppenderRef ref="ErrorFile"/>
        </Async>
    </Appenders>

    <Loggers>
        <!-- Root Logger -->
        <Root level="info" includeLocation="true">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncError" level="error"/>
        </Root>

        <!-- Spring Framework -->
        <Logger name="org.springframework" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncDebug"/>
            <AppenderRef ref="AsyncError" level="error"/>
        </Logger>

        <!-- Spring Cloud OpenFeign -->
        <Logger name="org.springframework.cloud.openfeign" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncDebug"/>
            <AppenderRef ref="AsyncError" level="error"/>
        </Logger>

        <!-- Application -->
        <Logger name="com.scccy.downloadvideo" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncDebug"/>
            <AppenderRef ref="AsyncError" level="error"/>
        </Logger>

        <!-- Factory Bean -->
        <Logger name="org.springframework.beans.factory" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncDebug"/>
            <AppenderRef ref="AsyncError" level="error"/>
        </Logger>
    </Loggers>
</Configuration>